# Slack — from api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Google Sheets (optional — omit and the bot posts to the channel only)
# SHEET_ID is the long string between /d/ and /edit in the sheet URL.
# Share the sheet with the key file's client_email as Editor, or nothing works.
GOOGLE_SHEET_ID=1AbC...
GOOGLE_WORKSHEET_NAME=Intake
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Gate tracking
GATES_DB=./gates.db
AUDIT_CHANNEL=#data-audit-champions

# Channel ID for downtime notices. Blank = log only, tell nobody.
ALERT_CHANNEL=

# Shared Drive id for project docs. Blank = no docs, everything else still works.
GOOGLE_DRIVE_FOLDER_ID=
# Domain to auto-share each doc with, so nobody has to request access.
GOOGLE_SHARE_DOMAIN=
# Your Slack subdomain, used to link the doc back to the thread.
SLACK_TEAM_DOMAIN=
