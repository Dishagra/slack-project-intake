{
  "_comment": "Edit this file to change the form. No Python changes needed. A field becomes a re-render trigger automatically if any other field's show_if references it. Field keys must be unique across common_fields plus any single project type.",
  "title": "New Project Intake",
  "submit_label": "Submit",
  "common_fields": [
    {
      "key": "project_name",
      "label": "Project name",
      "type": "text",
      "placeholder": "e.g. Multi-Turn Attack Bench"
    },
    {
      "key": "account",
      "label": "Customer",
      "type": "text",
      "placeholder": "e.g. Tencent"
    },
    {
      "key": "workstream",
      "label": "Workstream",
      "type": "select",
      "options": [
        {
          "label": "Red teaming / adversarial",
          "value": "red_team"
        },
        {
          "label": "Model evaluation / benchmark",
          "value": "eval"
        },
        {
          "label": "Data collection",
          "value": "collection"
        },
        {
          "label": "Annotation / labeling",
          "value": "annotation"
        },
        {
          "label": "RLHF / preference data",
          "value": "rlhf"
        },
        {
          "label": "Other",
          "value": "other"
        }
      ]
    },
    {
      "key": "workstream_other",
      "label": "Describe the workstream",
      "type": "text",
      "show_if": {
        "field": "workstream",
        "in": [
          "other"
        ]
      }
    },
    {
      "key": "research_owner",
      "label": "Research owner",
      "type": "user"
    },
    {
      "key": "delivery_owner",
      "label": "Delivery owner",
      "type": "user"
    },
    {
      "key": "sales_owner",
      "label": "Sales owner",
      "type": "user"
    },
    {
      "key": "urgency",
      "label": "Urgency",
      "type": "select",
      "options": [
        {
          "label": "Critical",
          "value": "critical"
        },
        {
          "label": "High",
          "value": "high"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Low",
          "value": "low"
        }
      ]
    },
    {
      "key": "urgency_justification",
      "label": "Why is this critical?",
      "type": "textarea",
      "hint": "Required for Critical only.",
      "show_if": {
        "field": "urgency",
        "in": [
          "critical"
        ]
      }
    },
    {
      "key": "target_date",
      "label": "Target delivery date",
      "type": "date"
    }
  ],
  "project_types": {
    "sample": {
      "label": "Sample",
      "_comment": "Mirrors Steps 0 and 1 of the Sample Creation Checklist. Steps 2-6 are gates that run after intake, not intake fields.",
      "fields": [
        {
          "key": "step0_header",
          "label": "— Step 0: before any build starts —",
          "type": "context"
        },
        {
          "key": "pipeline_relevance",
          "label": "Relevance across the pipeline",
          "type": "textarea",
          "hint": "Where else does this apply beyond this one customer?",
          "optional": true
        },
        {
          "key": "existing_asset",
          "label": "Existing asset we could reuse?",
          "type": "radio",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            },
            {
              "label": "Not checked yet",
              "value": "unchecked"
            }
          ]
        },
        {
          "key": "existing_asset_name",
          "label": "Which asset, and what changes?",
          "type": "text",
          "placeholder": "e.g. ARGO — extend taxonomy to multi-turn",
          "show_if": {
            "field": "existing_asset",
            "in": [
              "yes"
            ]
          }
        },
        {
          "key": "go_decision",
          "label": "Should we do it?",
          "type": "radio",
          "options": [
            {
              "label": "Go",
              "value": "go"
            },
            {
              "label": "No go",
              "value": "no_go"
            },
            {
              "label": "Needs discussion",
              "value": "discuss"
            }
          ]
        },
        {
          "key": "decision_notes",
          "label": "What has to be resolved first?",
          "type": "textarea",
          "show_if": {
            "field": "go_decision",
            "in": [
              "no_go",
              "discuss"
            ]
          }
        },
        {
          "key": "intake_stage",
          "label": "How far along is this?",
          "type": "radio",
          "hint": "Pick the first one and the research questions stay hidden — answer them later in the checklist thread.",
          "options": [
            {
              "label": "Just scoping — nothing started",
              "value": "scoping"
            },
            {
              "label": "Research underway",
              "value": "underway"
            },
            {
              "label": "Ready to build",
              "value": "ready"
            }
          ]
        },
        {
          "key": "step1_header",
          "label": "— Step 1: research and scope —",
          "type": "context",
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          }
        },
        {
          "key": "benchmark_status",
          "label": "Adjacent or customer-published benchmark",
          "type": "select",
          "options": [
            {
              "label": "Found — customer published",
              "value": "found_customer"
            },
            {
              "label": "Found — adjacent",
              "value": "found_adjacent"
            },
            {
              "label": "Confirmed none exists",
              "value": "confirmed_none"
            },
            {
              "label": "Not checked yet",
              "value": "unchecked"
            }
          ],
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          }
        },
        {
          "key": "benchmark_link",
          "label": "Benchmark link",
          "type": "url",
          "show_if": {
            "field": "benchmark_status",
            "in": [
              "found_customer",
              "found_adjacent"
            ]
          },
          "optional": true
        },
        {
          "key": "endpoints_probed",
          "label": "Endpoints probed",
          "type": "multi_select",
          "options": [
            {
              "label": "Customer-provided",
              "value": "customer"
            },
            {
              "label": "SOTA / public",
              "value": "sota"
            },
            {
              "label": "None yet",
              "value": "none"
            }
          ],
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          }
        },
        {
          "key": "probe_blocker",
          "label": "What is blocking probing?",
          "type": "textarea",
          "show_if": {
            "field": "endpoints_probed",
            "in": [
              "none"
            ]
          },
          "optional": true
        },
        {
          "key": "failure_pattern",
          "label": "The repeatable failure pattern",
          "type": "textarea",
          "hint": "One pattern the model actually shows — not a list of small issues.",
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          }
        },
        {
          "key": "taxonomy_status",
          "label": "Taxonomy v0",
          "type": "select",
          "options": [
            {
              "label": "Drafted, traces to the pattern",
              "value": "v0_ready"
            },
            {
              "label": "In progress",
              "value": "drafting"
            },
            {
              "label": "Not started",
              "value": "not_started"
            }
          ],
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          }
        },
        {
          "key": "taxonomy_link",
          "label": "Taxonomy doc link",
          "type": "url",
          "show_if": {
            "field": "taxonomy_status",
            "in": [
              "v0_ready",
              "drafting"
            ]
          },
          "optional": true
        },
        {
          "key": "delivery_header",
          "label": "— Step 1, in parallel: delivery —",
          "type": "context",
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          }
        },
        {
          "key": "annotator_profile",
          "label": "Annotator profile and sourcing",
          "type": "select",
          "options": [
            {
              "label": "Decided",
              "value": "decided"
            },
            {
              "label": "In progress",
              "value": "in_progress"
            },
            {
              "label": "Not started",
              "value": "not_started"
            }
          ],
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "ready"
            ]
          }
        },
        {
          "key": "annotator_notes",
          "label": "Profile / sourcing notes",
          "type": "textarea",
          "hint": "Expertise, language, headcount, where they come from.",
          "show_if": {
            "field": "annotator_profile",
            "in": [
              "decided",
              "in_progress"
            ]
          },
          "optional": true
        },
        {
          "key": "guideline_v0",
          "label": "Guideline v0 drafted from taxonomy v0?",
          "type": "radio",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "In progress",
              "value": "in_progress"
            },
            {
              "label": "Not started",
              "value": "no"
            }
          ],
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "ready"
            ]
          }
        },
        {
          "key": "lifecycle_mapped",
          "label": "Pipeline stages and task lifecycle mapped?",
          "type": "radio",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "In progress",
              "value": "in_progress"
            },
            {
              "label": "Not started",
              "value": "no"
            }
          ],
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "ready"
            ]
          }
