              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "optional": true,
          "show_if": {
            "field": "intake_stage",
            "in": [
              "underway",
              "ready"
            ]
          },
          "required_if": {
            "field": "intake_stage",
            "in": [
              "ready"
            ]
          }
        },
        {
          "key": "synthetic_pct",
          "label": "Synthetic share (%)",
          "type": "number",
          "decimal": true,
          "min_value": 0,
          "max_value": 70,
          "hint": "Hard cap is 70%.",
          "show_if": {
            "field": "uses_synthetic",
            "in": [
              "yes"
            ]
          },
          "optional": true
        },
        {
          "key": "hitl_role",
          "label": "Human-in-the-loop role",
